# Anthropic API key used by the Intent Engine, Goal Alignment Check,
# and Explanation/Safer-Alternative generator.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Model to use for all LLM calls in this service
ANTHROPIC_MODEL=claude-sonnet-4-5

# Backend
BACKEND_PORT=8000

# Frontend
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8000

# SQLite path for audit log (Person 4's module)
AUDIT_DB_PATH=/app/data/audit.db
